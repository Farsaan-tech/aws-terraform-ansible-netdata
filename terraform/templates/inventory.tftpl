[frontend]
${frontend_ip} ansible_user=ec2-user ansible_ssh_private_key_file=${ssh_key} ansible_python_interpreter=auto_silent

[backend]
${backend_ip} ansible_user=ubuntu ansible_ssh_private_key_file=${ssh_key} ansible_python_interpreter=auto_silent ansible_private_ip=${backend_private_ip}

[all:vars]
ansible_ssh_common_args='-o StrictHostKeyChecking=accept-new'
