aws_region             = "us-east-2"
project_name           = "tf-ansible-netdata"
environment            = "demo"
admin_cidr             = "203.0.113.10/32" # Replace with your own public IP/CIDR.
http_cidrs             = ["0.0.0.0/0"]
public_key_path        = "~/.ssh/pipeline_key.pub"
private_key_path       = "~/.ssh/pipeline_key"
frontend_instance_type = "t3.micro"
backend_instance_type  = "t3.micro"
